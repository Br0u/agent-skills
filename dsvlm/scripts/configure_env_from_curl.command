#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

cat <<'BANNER'
************************************************************************
*                                                                      *
*                ***************                                       *
*             ****             ****             华 鲲 元 启             *
*           ***   AAAAA   IIIII   ***                                  *
*          **    AA   AA    I      **       HUAKUN YUANQI AI           *
*          **    AAAAAAA    I      **                                  *
*          **    AA   AA    I      **       视频智能体配置向导          *
*           ***  AA   AA  IIIII  ***                                   *
*             ****             ****                                    *
*                ***************                                       *
*                                                                      *
*        +----------------------------------------------------+        *
*        |  1. auto-login-url                                |        *
*        |  2. login                                         |        *
*        |  3. theme data page                               |        *
*        +----------------------------------------------------+        *
*                                                                      *
*             按提示粘贴三段 cURL，每段粘完后按一次空行结束              *
*                                                                      *
************************************************************************
BANNER
echo

python3 "$SCRIPT_DIR/setup_env_from_curl.py"

